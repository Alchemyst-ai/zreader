{
  "name": "zreader",
  "version": "0.2.0",
  "description": "A localStorage-first, mobile-first book reader: chapters, bookmarks, sentence highlights, notes, reading progress and a WYSIWYG markdown scratchpad.",
  "license": "MIT",
  "author": "Alchemyst AI",
  "homepage": "https://github.com/alchemyst-ai/zreader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemyst-ai/zreader.git"
  },
  "bugs": {
    "url": "https://github.com/alchemyst-ai/zreader/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "reader",
    "ebook",
    "lms",
    "highlights",
    "bookmarks",
    "localStorage",
    "markdown",
    "mdx",
    "tiptap",
    "nextjs",
    "book-reader",
    "react",
    "react-19",
    "shadcn"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./config": {
      "import": {
        "types": "./dist/config/index.d.ts",
        "default": "./dist/config/index.js"
      },
      "require": {
        "types": "./dist/config/index.d.cts",
        "default": "./dist/config/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./next/client": {
      "types": "./dist/next/client/index.d.ts",
      "default": "./dist/next/client/index.js"
    },
    "./next/server": {
      "types": "./dist/next/server/index.d.ts",
      "browser": "./dist/stubs/server-only.js",
      "default": "./dist/next/server/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "browser": "./dist/stubs/server-only.js",
      "default": "./dist/content/index.js"
    },
    "./rehype": {
      "types": "./dist/rehype/index.d.ts",
      "default": "./dist/rehype/index.js"
    },
    "./virtual-config": {
      "types": "./dist/virtual-config/index.d.ts",
      "browser": "./dist/stubs/server-only.js",
      "default": "./dist/virtual-config/index.js"
    },
    "./user-config": {
      "types": "./dist/user-config/index.d.ts",
      "browser": "./dist/stubs/server-only.js",
      "default": "./dist/user-config/index.js"
    },
    "./empty-config": {
      "types": "./dist/stubs/empty-config.d.ts",
      "default": "./dist/stubs/empty-config.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "browser": "./dist/stubs/server-only.js",
      "default": "./dist/agent/index.js"
    },
    "./agent/react": {
      "types": "./dist/agent/react/index.d.ts",
      "default": "./dist/agent/react/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./reader.css": "./dist/reader.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/use-client.mjs && node scripts/check-bundles.mjs && npm run build:css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint && node scripts/attw.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run lint:pkg",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify && node scripts/unlayer-css.mjs && node scripts/copy-css.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.4",
    "approx-string-match": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "isomorphic-dompurify": "^4.6.0",
    "jiti": "^2.7.0",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-resizable-panels": "^4.16.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "sonner": "^2.0.8",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vaul": "^1.1.2",
    "vfile": "^6.0.3",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-list": "^3.0.0",
    "@tiptap/extensions": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "next": ">=15.5.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-list": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/markdown": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tailwindcss/cli": "^4.3.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "next": "16.3.5",
    "postcss": "^8.5.32",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
